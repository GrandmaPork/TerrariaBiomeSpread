[
  {
    // All these recipes are just matching templates. The actual quantity is determined in code in ItemNugget.OnCreatedByCrafting. The quantity is read from the ore attributes from the ore json file
    "ingredientPattern": "H,S",
    "ingredients": {
      "H": {
        "type": "item",
        "tags": [ "tool-hammer" ],
        "isTool": true
      },
      "S": {
        "type": "item",
        "code": "corruptore-poor-{ore}-*"
      }
    },
    "width": 1,
    "height": 2,
    "allowedVariants": {
      "ore": [ "shadowcopper", "shadowbismuthinite", "shadowcassiterite" ]
    },
    "output": {
      "type": "item",
      "code": "shadownugget-{ore}",
      "quantity": 1
    }
